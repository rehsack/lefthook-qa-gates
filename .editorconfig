# .editorconfig — whitespace hygiene only, one SSOT for every filetype in this repo.
#
# Deliberately NO syntax or style rules (indent_size, indent_style): those belong to the
# dedicated formatters — here shfmt, which lefthook/base.yml runs with -i 4. A second
# place for them violates SPOT and drifts apart from whatever the formatter does.
#
# Enforced by editorconfig-checker in lefthook/base.yml.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown: trailing whitespace can be a hard line break.
[*.md]
trim_trailing_whitespace = false
