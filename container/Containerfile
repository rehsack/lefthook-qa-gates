# lefthook-qa-gates — the base gate fleet for lefthook's pre-commit and commit-msg hooks.
#
# What every repository needs, whatever its language: whitespace hygiene, shell, the data
# formats (YAML, JSON, TOML, XML), compose files, container recipes, CI definitions,
# Markdown, the commit message and the secret scan. Languages and domains (C++, Perl, Python, Ruby, AsciiDoc)
# are not extensions of this image. They are images of their own beside it, each reached
# through a lefthook template of its own — orthogonal, not `FROM` this one. clang-tidy
# needs the SDK the code is built with, and no base image can know which one that is.
#
# Adapted from tpo42-asciidoc-container's container/mini.Containerfile (adc-mini-qa),
# which this image replaces. rubocop stayed behind: Ruby is a domain.
#
# Where each tool comes from:
#   gates — pinned upstream releases, whatever the channel: a release binary or pip.
#           A linter earns its place through the checks it has *newly* learned, and a
#           distribution that optimises for long-term compatibility optimises against
#           exactly that. Which version runs is a decision, and it belongs here.
#   base  — distribution packages: curl, git, jq, file, libxml2, the shells, the
#           runtimes. This is what a distribution's promise is actually worth having for.
#
# Fedora rather than Debian because it carries current interpreters, which is what the
# Python gates run on. It buys nothing for the gates themselves — those are pinned above
# the distribution either way.
#
# 44 is the newest stable release; 45 is frozen, not released. The tag pins the release
# line, not the package set — the base image is rebuilt within it, and `update` below
# takes what has landed since. A CVE fixed in the base should not wait for the next
# Fedora.
#
# The ARG pins below are what a dependency bot would move. Release asset names drift;
# verify them when bumping. gitleaks uses `x64` where everyone else writes `amd64`,
# dclint ships a glibc and a musl build, and editorconfig-checker renamed its binary
# from `ec` with 4.0.

FROM registry.fedoraproject.org/fedora-minimal:44

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- base: what the gates stand on -------------------------------------------
#
# zsh is the default login shell on macOS, so zsh scripts are a host artefact like any
# other. There is no zsh linter to install: shellcheck refuses the dialect outright
# ("Unknown shell: zsh", upstream #809), and z-shell/zsh-lint has published no release
# binary to date. `zsh -n` is a syntax gate, not a linter, and that is the honest claim
# for it.
#
# jq (JSON), libxml2 (xmllint — XML well-formedness, which has nothing to learn),
# file/libmagic (type detection beyond extensions — lefthook matches MIME types, which
# is how an extensionless bin/ script is caught), git-core (lefthook needs git; the -core
# split leaves out the Perl tooling nothing here calls), curl + ca-certificates (to fetch
# the gates), tar + gzip (to unpack them — fedora-minimal carries neither), python3-pip
# (the runtime the Python gates run on — the runtime, not the gates themselves).
#
# --setopt=install_weak_deps=0 is Fedora's equivalent of --no-install-recommends.
RUN microdnf update -y \
    && microdnf install -y --setopt=install_weak_deps=0 \
        ca-certificates \
        curl \
        file \
        git-core \
        gzip \
        jq \
        libxml2 \
        python3-pip \
        tar \
        zsh \
    && microdnf clean all

# --- gates that are Python programs ------------------------------------------
# In requirements.txt beside this file, so the pins sit where a reader looks for them
# and where a dependency bot can reach them.
RUN --mount=type=bind,source=requirements.txt,target=/tmp/requirements.txt,ro \
    pip install --disable-pip-version-check --no-cache-dir --break-system-packages \
        -r /tmp/requirements.txt

# --- gates that ship as release binaries --------------------------------------
#
# Version and digest belong to each other and move together. Where a project publishes a
# checksum file beside its release, the digest is read from there — not computed from the
# download, which would only assert that the bytes are the bytes that arrived.
# editorconfig-checker, actionlint, gitleaks, hadolint and lefthook do.
#
# shellcheck, shfmt, dclint and taplo publish none. Theirs are self-computed and carry
# less: they pin the artefact against a later change without vouching for the first
# fetch. Written down anyway, because that is still the difference between a silent
# substitution and a failed build.
#
# The build stops on a mismatch. That covers a tampered download and, just as usefully, a
# release re-cut under the same tag: either way the image is not built rather than built
# from something nobody reviewed.
#
# A digest belongs to one artefact, and an artefact is per architecture — so every pin is
# a pair. The alternative, resolving a digest at build time, is what the pin exists to
# prevent.
#
# The asset names do not agree on what to call an architecture: Go projects use GOARCH
# (amd64/arm64) and are named from TARGETARCH directly, while shellcheck says
# x86_64/aarch64 (and so does taplo), gitleaks says x64, hadolint and lefthook say
# x86_64. Those are mapped below rather than papered over.
#
# lefthook is here for the CI case only. Locally it runs on the host, beside git, and
# dispatches into this image; a runner without a host of its own (GitLab, Jenkins) runs
# lefthook inside it instead.
ARG SHELLCHECK_VERSION="0.11.0"
ARG SHELLCHECK_SHA256_AMD64="b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6"
ARG SHELLCHECK_SHA256_ARM64="68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc"
ARG SHFMT_VERSION="3.14.1"
ARG SHFMT_SHA256_AMD64="76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf"
ARG SHFMT_SHA256_ARM64="5f2db09dae91fca848f7adbdd014632e921a383863a2ad7e0450ad3aba0c6489"
ARG EC_VERSION="4.0.2"
ARG EC_SHA256_AMD64="44efaef3ed14c6ab52eb87481d78e5e5c204796dccf26e2f4598a61ba17f8003"
ARG EC_SHA256_ARM64="abad76da8c9950fdc2a314bcd66969172aa823e9c595fa7e3a389a91e34d025e"
ARG ACTIONLINT_VERSION="1.7.12"
ARG ACTIONLINT_SHA256_AMD64="8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
ARG ACTIONLINT_SHA256_ARM64="325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6"
ARG GITLEAKS_VERSION="8.30.1"
ARG GITLEAKS_SHA256_AMD64="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
ARG GITLEAKS_SHA256_ARM64="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
ARG HADOLINT_VERSION="2.15.1"
ARG HADOLINT_SHA256_AMD64="c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507"
ARG HADOLINT_SHA256_ARM64="f6198ef8090f404dbb771abfee086eb8c48ac177f30da7fd3510aca35b344b5d"
# docker-compose-linter publishes no checksum file. The project also ships on npm, whose
# registry does publish integrity metadata — a second distribution channel, at the price
# of node in this image. Recorded rather than decided.
ARG DCLINT_VERSION="3.1.0"
ARG DCLINT_SHA256_AMD64="5834586af5d3a5d3721dbb781cd87b4193e498f53671562864ca15567d1d42ac"
ARG DCLINT_SHA256_ARM64="ea58b5392e8c47c849b93028455d6df1a711b361ef49a870defa6b77b178e8ff"
# taplo publishes no checksum file either.
ARG TAPLO_VERSION="0.10.0"
ARG TAPLO_SHA256_AMD64="8fe196b894ccf9072f98d4e1013a180306e17d244830b03986ee5e8eabeb6156"
ARG TAPLO_SHA256_ARM64="033681d01eec8376c3fd38fa3703c79316f5e14bb013d859943b60a07bccdcc3"
ARG LEFTHOOK_VERSION="2.2.2"
ARG LEFTHOOK_SHA256_AMD64="4fbf89eb7748c6aed84d833ee1a29edac48fae614468ca9a82896ec32f2800b6"
ARG LEFTHOOK_SHA256_ARM64="a4d4bf78d902af1a148bf0662af08e13b791061e46e6e2183b0660eed96b43f6"

# Supplied by BuildKit; declaring it is what brings it into scope.
ARG TARGETARCH

# `set -eu` only: pipefail already comes from the SHELL instruction above, and repeating
# it here makes shellcheck read the block as POSIX sh, where the option does not exist.
#
# Downloaded to a file rather than piped into tar, because a pipe has consumed the bytes
# by the time there is anything to check them against.
RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) sc_arch=x86_64;  gl_arch=x64;   hl_arch=x86_64; lh_arch=x86_64; \
               sc_sha="${SHELLCHECK_SHA256_AMD64}"; sf_sha="${SHFMT_SHA256_AMD64}"; \
               ec_sha="${EC_SHA256_AMD64}";         al_sha="${ACTIONLINT_SHA256_AMD64}"; \
               gl_sha="${GITLEAKS_SHA256_AMD64}";   hl_sha="${HADOLINT_SHA256_AMD64}"; \
               dc_sha="${DCLINT_SHA256_AMD64}";     lh_sha="${LEFTHOOK_SHA256_AMD64}"; \
               tp_sha="${TAPLO_SHA256_AMD64}" ;; \
        arm64) sc_arch=aarch64; gl_arch=arm64; hl_arch=arm64;  lh_arch=arm64; \
               sc_sha="${SHELLCHECK_SHA256_ARM64}"; sf_sha="${SHFMT_SHA256_ARM64}"; \
               ec_sha="${EC_SHA256_ARM64}";         al_sha="${ACTIONLINT_SHA256_ARM64}"; \
               gl_sha="${GITLEAKS_SHA256_ARM64}";   hl_sha="${HADOLINT_SHA256_ARM64}"; \
               dc_sha="${DCLINT_SHA256_ARM64}";     lh_sha="${LEFTHOOK_SHA256_ARM64}"; \
               tp_sha="${TAPLO_SHA256_ARM64}" ;; \
        *) echo "No gate binaries pinned for TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    fetch() { \
        curl -fsSL -o "$2" "$1"; \
        echo "$3  $2" | sha256sum -c -; \
    }; \
    fetch "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/shellcheck-v${SHELLCHECK_VERSION}.linux.${sc_arch}.tar.gz" \
        /tmp/shellcheck.tar.gz "${sc_sha}"; \
    tar -xzf /tmp/shellcheck.tar.gz -C /tmp; \
    install -m0755 "/tmp/shellcheck-v${SHELLCHECK_VERSION}/shellcheck" /usr/local/bin/shellcheck; \
    fetch "https://github.com/mvdan/sh/releases/download/v${SHFMT_VERSION}/shfmt_v${SHFMT_VERSION}_linux_${TARGETARCH}" \
        /tmp/shfmt "${sf_sha}"; \
    install -m0755 /tmp/shfmt /usr/local/bin/shfmt; \
    fetch "https://github.com/editorconfig-checker/editorconfig-checker/releases/download/v${EC_VERSION}/editorconfig-checker-linux-${TARGETARCH}.tar.gz" \
        /tmp/ec.tar.gz "${ec_sha}"; \
    mkdir /tmp/ec; \
    tar -xzf /tmp/ec.tar.gz -C /tmp/ec editorconfig-checker; \
    install -m0755 /tmp/ec/editorconfig-checker /usr/local/bin/editorconfig-checker; \
    fetch "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${TARGETARCH}.tar.gz" \
        /tmp/actionlint.tar.gz "${al_sha}"; \
    tar -xzf /tmp/actionlint.tar.gz -C /tmp actionlint; \
    install -m0755 /tmp/actionlint /usr/local/bin/actionlint; \
    fetch "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${gl_arch}.tar.gz" \
        /tmp/gitleaks.tar.gz "${gl_sha}"; \
    tar -xzf /tmp/gitleaks.tar.gz -C /tmp gitleaks; \
    install -m0755 /tmp/gitleaks /usr/local/bin/gitleaks; \
    fetch "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-${hl_arch}" \
        /tmp/hadolint "${hl_sha}"; \
    install -m0755 /tmp/hadolint /usr/local/bin/hadolint; \
    fetch "https://github.com/zavoloklom/docker-compose-linter/releases/download/v${DCLINT_VERSION}/dclint-bullseye-${TARGETARCH}" \
        /tmp/dclint "${dc_sha}"; \
    install -m0755 /tmp/dclint /usr/local/bin/dclint; \
    fetch "https://github.com/evilmartians/lefthook/releases/download/v${LEFTHOOK_VERSION}/lefthook_${LEFTHOOK_VERSION}_Linux_${lh_arch}" \
        /tmp/lefthook "${lh_sha}"; \
    install -m0755 /tmp/lefthook /usr/local/bin/lefthook; \
    fetch "https://github.com/tamasfe/taplo/releases/download/${TAPLO_VERSION}/taplo-linux-${sc_arch}.gz" \
        /tmp/taplo.gz "${tp_sha}"; \
    gzip -d /tmp/taplo.gz; \
    install -m0755 /tmp/taplo /usr/local/bin/taplo; \
    rm -rf /tmp/shellcheck* /tmp/shfmt /tmp/ec /tmp/ec.tar.gz /tmp/actionlint* \
        /tmp/gitleaks* /tmp/hadolint /tmp/dclint /tmp/lefthook /tmp/taplo

# Fail the build when an asset name drifted, rather than the next commit.
RUN editorconfig-checker --version \
    && actionlint --version \
    && gitleaks version \
    && hadolint --version \
    && dclint --version \
    && lefthook version \
    && taplo --version \
    && shellcheck --version \
    && shfmt --version \
    && zsh --version \
    && yamllint --version \
    && gitlint --version \
    && check-jsonschema --version \
    && mdformat --version \
    && reuse --version \
    && xmllint --version \
    && jq --version

# --- what the image bundles, and where its source is ---------------------------
#
# Publishing this image distributes everything in it, copyleft included, so the image
# says what it carries. Each list comes from the place that knows: the distribution's
# packages from the rpm database, the Python ones from their own metadata — both read
# at build time, so neither can drift from what was installed. The release binaries
# carry no metadata of that kind; their version and source come from the ARGs above,
# their license is stated here, once per tool, and checked when the tool is bumped.
#
# Source is referenced, not mirrored: Fedora publishes the sources of its packages, the
# Python packages are pure Python or come with an sdist on PyPI, and the binaries point
# at the upstream tag. The GPL-3 ones are shellcheck (-or-later, per its source headers)
# and hadolint (-only: Cabal's `GPL-3`).
ARG THIRD_PARTY_DIR=/usr/local/share/lefthook-qa-gates/third-party
RUN set -eu; \
    mkdir -p "${THIRD_PARTY_DIR}"; \
    { \
        printf 'name\tversion\tlicense\tsource\n'; \
        printf 'actionlint\t%s\tMIT\thttps://github.com/rhysd/actionlint/archive/refs/tags/v%s.tar.gz\n' "${ACTIONLINT_VERSION}" "${ACTIONLINT_VERSION}"; \
        printf 'dclint\t%s\tMIT\thttps://github.com/zavoloklom/docker-compose-linter/archive/refs/tags/v%s.tar.gz\n' "${DCLINT_VERSION}" "${DCLINT_VERSION}"; \
        printf 'editorconfig-checker\t%s\tMIT\thttps://github.com/editorconfig-checker/editorconfig-checker/archive/refs/tags/v%s.tar.gz\n' "${EC_VERSION}" "${EC_VERSION}"; \
        printf 'gitleaks\t%s\tMIT\thttps://github.com/gitleaks/gitleaks/archive/refs/tags/v%s.tar.gz\n' "${GITLEAKS_VERSION}" "${GITLEAKS_VERSION}"; \
        printf 'hadolint\t%s\tGPL-3.0-only\thttps://github.com/hadolint/hadolint/archive/refs/tags/v%s.tar.gz\n' "${HADOLINT_VERSION}" "${HADOLINT_VERSION}"; \
        printf 'lefthook\t%s\tMIT\thttps://github.com/evilmartians/lefthook/archive/refs/tags/v%s.tar.gz\n' "${LEFTHOOK_VERSION}" "${LEFTHOOK_VERSION}"; \
        printf 'shellcheck\t%s\tGPL-3.0-or-later\thttps://github.com/koalaman/shellcheck/archive/refs/tags/v%s.tar.gz\n' "${SHELLCHECK_VERSION}" "${SHELLCHECK_VERSION}"; \
        printf 'shfmt\t%s\tBSD-3-Clause\thttps://github.com/mvdan/sh/archive/refs/tags/v%s.tar.gz\n' "${SHFMT_VERSION}" "${SHFMT_VERSION}"; \
        printf 'taplo\t%s\tMIT\thttps://github.com/tamasfe/taplo/archive/refs/tags/%s.tar.gz\n' "${TAPLO_VERSION}" "${TAPLO_VERSION}"; \
    } > "${THIRD_PARTY_DIR}/binaries.tsv"; \
    { \
        printf 'name\tversion-release\tlicense\tsource-rpm\n'; \
        rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\t%{LICENSE}\t%{SOURCERPM}\n' | sort; \
    } > "${THIRD_PARTY_DIR}/rpm.tsv"
RUN --mount=type=bind,source=build/python-licenses.py,target=/tmp/python-licenses.py,ro \
    python3 /tmp/python-licenses.py > "${THIRD_PARTY_DIR}/python.tsv"

# --- what this project adds: job wrappers, schema, catalog, seeds -------------
#
# The build context is laid out as the prefix it is installed into, so a wrapper finds
# its data at the same relative path in a checkout and in the image: bin/../share.
COPY bin/ /usr/local/bin/
COPY share/ /usr/local/share/

# git refuses to operate on a bind-mounted worktree owned by another uid unless it is
# marked safe. The fleet always works on /workspace.
RUN git config --system --add safe.directory /workspace

ARG USER_UID="1000"
ARG USER_GID="1000"
ARG USER_NAME="gates"
ARG USER_GROUP_NAME="gates"

# The caller's identity, so the formatters can rewrite files the workspace owns.
#
# Two constraints pull against each other here. The numeric ids have to match the host's
# or the bind mount is unwritable — that is the whole point. But everything below 100 is
# reserved for the distribution, and macOS hands every user gid 20, which every
# distribution has already given to something — `games` on Fedora, `dialout` on Debian.
# So: reuse an id that exists, never create one in the reserved range, and fall back to
# running as a bare number when no account can be made for it. Docker accepts a numeric
# USER without a passwd entry; the tools here are linters and read their git identity
# from GIT_CONFIG_* rather than from a home directory.
RUN set -eu; \
    if [ "${USER_GID}" -ge 100 ] && ! getent group "${USER_GID}" >/dev/null 2>&1; then \
        groupadd --gid "${USER_GID}" "${USER_GROUP_NAME}"; \
    fi; \
    if [ "${USER_UID}" -ge 100 ] \
        && ! getent passwd "${USER_UID}" >/dev/null 2>&1 \
        && getent group "${USER_GID}" >/dev/null 2>&1; then \
        useradd --uid "${USER_UID}" --gid "${USER_GID}" \
            --create-home --shell /bin/bash "${USER_NAME}"; \
    fi

# Tools cache under XDG_CACHE_HOME, falling back to $HOME. On the numeric path above
# there is no passwd entry, so HOME is `/`. Naming a writable location costs nothing and
# is what makes that path usable; the image is built for one identity, so a shared
# directory is not a shared-tenant problem.
ENV XDG_CACHE_HOME=/tmp/cache
RUN mkdir -p /tmp/cache && chmod 0777 /tmp/cache

# Static here; CI replaces the version and adds the revision. `licenses` names what this
# repository licenses — the bundled tools carry their own, listed under third-party/.
# vendor, url and version are set because the base image's would otherwise be inherited,
# and this image would describe itself as Fedora 44.
LABEL org.opencontainers.image.title="lefthook-qa-gates" \
      org.opencontainers.image.version="unreleased" \
      org.opencontainers.image.vendor="Jens Rehsack" \
      org.opencontainers.image.url="https://github.com/rehsack/lefthook-qa-gates" \
      org.opencontainers.image.description="Base gate fleet for lefthook's pre-commit and commit-msg hooks" \
      org.opencontainers.image.source="https://github.com/rehsack/lefthook-qa-gates" \
      org.opencontainers.image.licenses="Apache-2.0 AND 0BSD AND CC-BY-SA-4.0"

USER ${USER_UID}:${USER_GID}
WORKDIR /workspace
